{
  "name": "alien-local-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "check": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "build": "tsc && vite build",
    "start": "node scripts/supervisor.mjs",
    "doctor": "node scripts/doctor.mjs",
    "release:check": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@fastify/static": "10.1.8",
    "@playwright/mcp": "0.0.83",
    "ajv": "8.20.0",
    "fastify": "5.12.7",
    "ical.js": "2.2.1",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdav": "2.5.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
